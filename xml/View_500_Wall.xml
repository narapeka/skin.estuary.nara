<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_500_Wall">
		<control type="group">
			<include>OpenClose_Right</include>
			<left>50</left>
			<top>0</top>
			<visible>Control.IsVisible(500)</visible>
			<include>Visible_Right</include>
			<control type="panel" id="500">
				<left>0</left>
				<top>topbar_content_top</top>
				<width>98%</width>
				<bottom>0</bottom>
				<onleft>9000</onleft>
				<onright condition="$EXP[wall_alphabet_active]">50060</onright>
				<onright condition="!$EXP[wall_alphabet_active]">531</onright>
				<onup condition="Integer.IsGreater(Container.NumPages,1)">500</onup>
				<onup condition="!Integer.IsGreater(Container.NumPages,1)">9000</onup>
				<ondown>500</ondown>
				<viewtype label="31102">icon</viewtype>
				<preloaditems>2</preloaditems>
				<pagecontrol>531</pagecontrol>
				<scrolltime tween="cubic" easing="out">350</scrolltime>
				<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(artists) | Container.Content(albums) | Container.Content(musicvideos) | Container.Content(addons) | Container.Content(images) | Container.Content(videos) | Container.Content(favourites) | $EXP[videoasset_true]</visible>
				<itemlayout height="430" width="260" condition="Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | [Container.Content(musicvideos) + Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<top>10</top>
						<include>InfoWallMovieLayout</include>
					</control>
				</itemlayout>
				<focusedlayout height="430" width="260" condition="Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | [Container.Content(musicvideos) + Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="106" time="200" tween="sine" easing="inout" center="130,224">Focus</animation>
						<animation effect="zoom" start="106" end="100" time="200" tween="sine" easing="inout" center="130,224">UnFocus</animation>
						<top>10</top>
						<include content="InfoWallMovieLayout">
							<param name="focused" value="true" />
							<param name="progress_visible_condition" value="[!Control.HasFocus(500) | !Integer.IsEqual(ListItem.CurrentItem,Container(500).CurrentItem)]" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="301" width="300" condition="Container.Content(videos) | [Container.Content(musicvideos) + !Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<top>10</top>
						<include content="InfoWallEpisodeLayout">
							<param name="label" value="$INFO[ListItem.Label]" />
							<param name="thumb_label" value="$INFO[ListItem.Label2]" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="301" width="300" condition="Container.Content(videos) | [Container.Content(musicvideos) + !Skin.HasSetting(show_musicvideoposter)]">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="160,180">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="160,180">UnFocus</animation>
						<top>10</top>
						<include content="InfoWallEpisodeLayout">
							<param name="focused" value="true" />
							<param name="thumb_label" value="$INFO[ListItem.Label2]" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="425" width="442" condition="Container.Content(images)">
					<control type="group">
						<left>40</left>
						<top>50</top>
						<include>InfoWallPictureLayout</include>
					</control>
				</itemlayout>
				<focusedlayout height="425" width="442" condition="Container.Content(images)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="220,230">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="220,230">UnFocus</animation>
						<left>40</left>
						<top>50</top>
						<include content="InfoWallPictureLayout">
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="401" width="300" condition="Container.Content(artists) | Container.Content(albums)">
					<control type="group">
						<top>50</top>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultMusicSongs.png" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="401" width="300" condition="Container.Content(artists) | Container.Content(albums)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<top>50</top>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="160,250">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="160,250">UnFocus</animation>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultMusicSongs.png" />
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="401" width="300" condition="Container.Content(addons)">
					<control type="group">
						<top>50</top>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultAddon.png" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="401" width="300" condition="Container.Content(addons)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<top>50</top>
						<animation effect="zoom" start="100" end="110" time="200" tween="sine" easing="inout" center="160,250">Focus</animation>
						<animation effect="zoom" start="110" end="100" time="200" tween="sine" easing="inout" center="160,250">UnFocus</animation>
						<include content="InfoWallMusicLayout">
							<param name="fallback_image" value="DefaultAddon.png" />
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
				<itemlayout height="430" width="260" condition="Container.Content(favourites)">
					<control type="group">
						<top>18</top>
						<include content="InfoWallFavouriteLayout">
							<param name="focused" value="false" />
						</include>
					</control>
				</itemlayout>
				<focusedlayout height="430" width="260" condition="Container.Content(favourites)">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<top>18</top>
						<animation effect="zoom" start="100" end="106" time="200" tween="sine" easing="inout" center="130,224">Focus</animation>
						<animation effect="zoom" start="106" end="100" time="200" tween="sine" easing="inout" center="130,224">UnFocus</animation>
						<include content="InfoWallFavouriteLayout">
							<param name="focused" value="true" />
						</include>
					</control>
				</focusedlayout>
			</control>
			<control type="group">
				<right>0</right>
				<centertop>50%</centertop>
				<width>52</width>
				<height>810</height>
				<include content="NaraVerticalAlphabetIndex">
					<param name="container_id" value="500" />
					<param name="control_id" value="50060" />
					<param name="return_control_id" value="500" />
					<param name="visible" value="$EXP[wall_alphabet_active]" />
				</include>
			</control>
		</control>
	</include>
</includes>
