<?xml version="1.0" encoding="utf-8"?>
<includes>
	<!-- Cast and collection shelf: isolated for alternate people and media layouts. -->
	<include name="VideoInfoCastShelf">
		<control type="group">
			<left>80</left>
			<top>816</top>
			<width>1760</width>
			<height>270</height>
			<visible>Integer.IsGreater(Container(50).NumItems,0) + [!String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(Container(5100).ListItem.Property(VideoInfoTab),cast)]</visible>
			<animation effect="slide" start="0,70" end="0,0" time="400" delay="100" tween="cubic" easing="out">WindowOpen</animation>
			<control type="label">
				<width>500</width>
				<height>32</height>
				<font>font20_title</font>
				<label>$LOCALIZE[20457]</label>
				<visible>Container.Content(Sets)</visible>
			</control>
			<control type="panel" id="50">
				<top>34</top>
				<width>1760</width>
				<height>232</height>
				<orientation>horizontal</orientation>
				<scrolltime>220</scrolltime>
				<preloaditems>2</preloaditems>
				<onleft>50</onleft>
				<onright>50</onright>
				<onup condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)">5100</onup>
				<onup>5000</onup>
				<ondown>50</ondown>
				<onclick condition="System.AddonIsEnabled(script.embuary.info) + !String.IsEqual(ListItem.DBType,set)">RunScript(script.embuary.info,call=person,query='$ESCINFO[Container(50).ListItem.Label]')</onclick>
				<onclick condition="System.HasAddon(script.embuary.info) + !System.AddonIsEnabled(script.embuary.info) + !String.IsEqual(ListItem.DBType,set)">EnableAddon(script.embuary.info)</onclick>
				<onclick condition="!System.HasAddon(script.embuary.info) + !String.IsEqual(ListItem.DBType,set)">InstallAddon(script.embuary.info)</onclick>
				<itemlayout height="206" width="160" condition="!Container.Content(Sets)">
					<control type="group">
						<left>0</left>
						<top>4</top>
						<control type="image">
							<left>15</left>
							<width>130</width>
							<height>130</height>
							<aspectratio>stretch</aspectratio>
							<texture colordiffuse="28FFFFFF">masks/circle.png</texture>
						</control>
						<control type="image">
							<left>19</left>
							<top>4</top>
							<width>122</width>
							<height>122</height>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<texture diffuse="masks/circle.png" fallback="DefaultActorSolid.png" background="true">$INFO[ListItem.Thumb]</texture>
						</control>
						<control type="label">
							<top>134</top>
							<width>160</width>
							<height>28</height>
							<font>font12</font>
							<align>center</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<top>166</top>
							<width>160</width>
							<height>26</height>
							<font>font10</font>
							<align>center</align>
							<textcolor>text_secondary</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="206" width="160" condition="!Container.Content(Sets)">
					<control type="group">
						<left>0</left>
						<top>4</top>
						<animation center="80,65" effect="zoom" start="100" end="104" time="150" tween="sine">Focus</animation>
						<control type="image">
							<left>15</left>
							<width>130</width>
							<height>130</height>
							<aspectratio>stretch</aspectratio>
							<texture colordiffuse="focus_media">masks/circle.png</texture>
						</control>
						<control type="image">
							<left>19</left>
							<top>4</top>
							<width>122</width>
							<height>122</height>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<texture diffuse="masks/circle.png" fallback="DefaultActorSolid.png" background="true">$INFO[ListItem.Thumb]</texture>
						</control>
						<control type="label">
							<top>134</top>
							<width>160</width>
							<height>28</height>
							<font>font12</font>
							<align>center</align>
							<aligny>center</aligny>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<top>166</top>
							<width>160</width>
							<height>26</height>
							<font>font10</font>
							<align>center</align>
							<textcolor>text_secondary</textcolor>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</control>
				</focusedlayout>
				<itemlayout height="230" width="168" condition="Container.Content(Sets)">
					<control type="group">
						<left>6</left>
						<top>4</top>
						<control type="image">
							<width>146</width>
							<height>204</height>
							<aspectratio>scale</aspectratio>
							<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Art(poster)]</texture>
						</control>
						<control type="image">
							<top>144</top>
							<width>146</width>
							<height>60</height>
							<aspectratio>stretch</aspectratio>
							<texture>overlays/overlayfade.png</texture>
						</control>
						<control type="label">
							<left>8</left>
							<top>172</top>
							<width>130</width>
							<height>28</height>
							<font>font10</font>
							<align>center</align>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="230" width="168" condition="Container.Content(Sets)">
					<control type="group">
						<left>6</left>
						<top>4</top>
						<animation center="73,102" effect="zoom" start="100" end="104" time="160" tween="sine">Focus</animation>
						<control type="image">
							<width>146</width>
							<height>204</height>
							<aspectratio>scale</aspectratio>
							<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Art(poster)]</texture>
						</control>
						<control type="image">
							<left>-2.884615</left>
							<top>-2.884615</top>
							<width>151.769230</width>
							<height>209.769230</height>
							<texture border="3" infill="false" colordiffuse="focus_media">colors/white.png</texture>
						</control>
						<control type="image">
							<top>144</top>
							<width>146</width>
							<height>60</height>
							<aspectratio>stretch</aspectratio>
							<texture>overlays/overlayfade.png</texture>
						</control>
						<control type="label">
							<left>8</left>
							<top>172</top>
							<width>130</width>
							<height>28</height>
							<font>font10</font>
							<align>center</align>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
		</control>
	</include>
</includes>
