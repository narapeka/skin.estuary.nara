	<include name="NaraSearchWindow">
		<!-- Search results retain the information-dialog fanart treatment. Only the
		     empty-query random backdrop matches Files, Favorites and File Manager. -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture>colors/black.png</texture>
		</control>
		<!-- Empty-query backdrop comes from Home's shared movie provider, including
		     its persistent lock and just-unlocked session hold. -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<aspectratio align="right">scale</aspectratio>
			<fadetime>250</fadetime>
			<texture background="true" colordiffuse="B3FFFFFF">$VAR[NaraSharedRandomFanartVar]</texture>
			<visible>String.IsEmpty(Control.GetLabel(16999).index(1)) + !Skin.HasSetting(no_fanart) + ![String.IsEmpty(Skin.String(Nara.SharedRandomFanart.LockedPath)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart.SessionPath)) + String.IsEmpty(Container(16090).ListItem.Art(fanart))]</visible>
		</control>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<aspectratio align="right">scale</aspectratio>
			<fadetime>350</fadetime>
			<texture background="true">$VAR[NaraSearchFanartVar]</texture>
			<visible>!String.IsEmpty(Control.GetLabel(16999).index(1)) + !Skin.HasSetting(no_fanart) + [[$EXP[NaraSearchMoviesActive] + !String.IsEmpty(Container(16101).ListItemSettled.Art(fanart))] | [$EXP[NaraSearchTVShowsActive] + !String.IsEmpty(Container(16102).ListItemSettled.Art(fanart))]]</visible>
