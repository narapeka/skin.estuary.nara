<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Kodi interprets bare numeric labels as localization IDs. Fuse 2 avoids
	     that ambiguity by routing every digit through a literal variable. -->
	<variable name="NaraSearchNumber0"><value>0</value></variable>
	<variable name="NaraSearchNumber1"><value>1</value></variable>
	<variable name="NaraSearchNumber2"><value>2</value></variable>
	<variable name="NaraSearchNumber3"><value>3</value></variable>
	<variable name="NaraSearchNumber4"><value>4</value></variable>
	<variable name="NaraSearchNumber5"><value>5</value></variable>
	<variable name="NaraSearchNumber6"><value>6</value></variable>
	<variable name="NaraSearchNumber7"><value>7</value></variable>
	<variable name="NaraSearchNumber8"><value>8</value></variable>
	<variable name="NaraSearchNumber9"><value>9</value></variable>

	<!--
		Local-library search paths deliberately use the smart-playlist title/contains
		rule. Narapeka Kodi extends this rule for movies and TV shows so the query
		also matches the cached pinyin-initial alias in the video database.
	-->
	<variable name="NaraSearchMoviesPathVar">
		<value condition="!String.IsEmpty(Control.GetLabel(16999).index(1))">videodb://movies/titles/?xsp={"order":{"direction":"ascending","ignorefolders":0,"method":"sorttitle"},"rules":{"and":[{"field":"title","operator":"contains","value":["$INFO[Control.GetLabel(16999).index(1)]"]}]},"type":"movies"}</value>
	</variable>
	<variable name="NaraSearchTVShowsPathVar">
		<value condition="!String.IsEmpty(Control.GetLabel(16999).index(1))">videodb://tvshows/titles/?xsp={"order":{"direction":"ascending","ignorefolders":0,"method":"sorttitle"},"rules":{"and":[{"field":"title","operator":"contains","value":["$INFO[Control.GetLabel(16999).index(1)]"]}]},"type":"tvshows"}</value>
	</variable>
	<!-- Keep the active result type independent from the order in which the two
	     asynchronous directory providers finish. A valid explicit tab choice wins;
	     otherwise movies are the deterministic default, falling back to TV only
	     when the movie result is empty. -->
	<expression name="NaraSearchMoviesActive">Integer.IsGreater(Container(16101).NumItems,0) + [!String.IsEqual(Window(home).Property(Search.ActiveType),tvshows) | Integer.IsEqual(Container(16102).NumItems,0)]</expression>
	<expression name="NaraSearchTVShowsActive">Integer.IsGreater(Container(16102).NumItems,0) + [String.IsEqual(Window(home).Property(Search.ActiveType),tvshows) | Integer.IsEqual(Container(16101).NumItems,0)]</expression>
	<expression name="NaraSearchKeyboardHidden">!String.IsEmpty(Control.GetLabel(16999).index(1)) + !ControlGroup(16010).HasFocus() + [ControlGroup(16020).HasFocus() | !String.IsEmpty(Window(home).Property(Search.KeyboardHidden))]</expression>
	<variable name="NaraSearchFanartVar">
		<value condition="$EXP[NaraSearchMoviesActive]">$INFO[Container(16101).ListItemSettled.Art(fanart)]</value>
		<value condition="$EXP[NaraSearchTVShowsActive]">$INFO[Container(16102).ListItemSettled.Art(fanart)]</value>
	</variable>
	<variable name="NaraSearchPosterVar">
		<value condition="$EXP[NaraSearchMoviesActive]">$INFO[Container(16101).ListItemSettled.Art(poster)]</value>
		<value condition="$EXP[NaraSearchTVShowsActive]">$INFO[Container(16102).ListItemSettled.Art(poster)]</value>
	</variable>
	<!-- Fuse 2 search keyboard input mapping. Kodi's Number actions provide the
	     multi-tap letter entry while focus briefly sits on the hidden edit. -->
	<include name="NaraSearchInputA"><onclick>Number2</onclick></include>
	<include name="NaraSearchInputB"><onclick>Number2</onclick><onclick>Number2</onclick></include>
	<include name="NaraSearchInputC"><onclick>Number2</onclick><onclick>Number2</onclick><onclick>Number2</onclick></include>
	<include name="NaraSearchInputD"><onclick>Number3</onclick></include>
	<include name="NaraSearchInputE"><onclick>Number3</onclick><onclick>Number3</onclick></include>
	<include name="NaraSearchInputF"><onclick>Number3</onclick><onclick>Number3</onclick><onclick>Number3</onclick></include>
	<include name="NaraSearchInputG"><onclick>Number4</onclick></include>
	<include name="NaraSearchInputH"><onclick>Number4</onclick><onclick>Number4</onclick></include>
	<include name="NaraSearchInputI"><onclick>Number4</onclick><onclick>Number4</onclick><onclick>Number4</onclick></include>
	<include name="NaraSearchInputJ"><onclick>Number5</onclick></include>
	<include name="NaraSearchInputK"><onclick>Number5</onclick><onclick>Number5</onclick></include>
	<include name="NaraSearchInputL"><onclick>Number5</onclick><onclick>Number5</onclick><onclick>Number5</onclick></include>
	<include name="NaraSearchInputM"><onclick>Number6</onclick></include>
	<include name="NaraSearchInputN"><onclick>Number6</onclick><onclick>Number6</onclick></include>
	<include name="NaraSearchInputO"><onclick>Number6</onclick><onclick>Number6</onclick><onclick>Number6</onclick></include>
	<include name="NaraSearchInputP"><onclick>Number7</onclick></include>
	<include name="NaraSearchInputQ"><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInputR"><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInputS"><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInputT"><onclick>Number8</onclick></include>
	<include name="NaraSearchInputU"><onclick>Number8</onclick><onclick>Number8</onclick></include>
	<include name="NaraSearchInputV"><onclick>Number8</onclick><onclick>Number8</onclick><onclick>Number8</onclick></include>
	<include name="NaraSearchInputW"><onclick>Number9</onclick></include>
	<include name="NaraSearchInputX"><onclick>Number9</onclick><onclick>Number9</onclick></include>
	<include name="NaraSearchInputY"><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick></include>
	<include name="NaraSearchInputZ"><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick></include>
	<include name="NaraSearchInputBackspace"><onclick>Backspace</onclick></include>

	<!-- The numeric page is hidden until the 0-9 key is selected. The repeated
	     actions cycle Kodi's multi-tap input to the literal digit, exactly as in
	     Fuse 2. -->
	<include name="NaraSearchInput0">
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
	</include>
	<include name="NaraSearchInput1">
		<onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick>
		<onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick>
		<onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick>
	</include>
	<include name="NaraSearchInput2"><onclick>Number2</onclick><onclick>Number2</onclick><onclick>Number2</onclick><onclick>Number2</onclick></include>
	<include name="NaraSearchInput3"><onclick>Number3</onclick><onclick>Number3</onclick><onclick>Number3</onclick><onclick>Number3</onclick></include>
	<include name="NaraSearchInput4"><onclick>Number4</onclick><onclick>Number4</onclick><onclick>Number4</onclick><onclick>Number4</onclick></include>
	<include name="NaraSearchInput5"><onclick>Number5</onclick><onclick>Number5</onclick><onclick>Number5</onclick><onclick>Number5</onclick></include>
	<include name="NaraSearchInput6"><onclick>Number6</onclick><onclick>Number6</onclick><onclick>Number6</onclick><onclick>Number6</onclick></include>
	<include name="NaraSearchInput7"><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInput8"><onclick>Number8</onclick><onclick>Number8</onclick><onclick>Number8</onclick><onclick>Number8</onclick></include>
	<include name="NaraSearchInput9"><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick></include>

	<include name="NaraSearchKeyboardItemLayout">
		<param name="focused">false</param>
		<param name="textcolor">text_primary</param>
		<definition>
			<control type="image">
				<left>2</left>
				<top>0</top>
				<width>42</width>
				<height>42</height>
				<texture colordiffuse="focus_surface">lists/focus.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>46</width>
				<height>42</height>
				<font>font24_search_bold</font>
				<label>$INFO[ListItem.Label]</label>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>$PARAM[textcolor]</textcolor>
			</control>
			<control type="image">
				<left>10</left>
				<top>9</top>
				<width>26</width>
				<height>24</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="focus_foreground">$INFO[ListItem.Icon]</texture>
				<visible>$PARAM[focused] + !String.IsEmpty(ListItem.Icon)</visible>
			</control>
			<control type="image">
				<left>10</left>
				<top>9</top>
				<width>26</width>
				<height>24</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="text_primary">$INFO[ListItem.Icon]</texture>
				<visible>!$PARAM[focused] + !String.IsEmpty(ListItem.Icon)</visible>
			</control>
		</definition>
	</include>

	<include name="NaraSearchKeyboard">
		<!-- Hidden receiver for Fuse 2's remote-friendly multi-tap input. -->
		<control type="edit" id="16999">
			<left>-1000</left>
			<top>-1000</top>
			<width>1</width>
			<height>1</height>
			<onfocus>ClearProperty(Search.KeyboardHidden,home)</onfocus>
			<ondown>16992</ondown>
			<onleft>noop</onleft>
			<ontextchange>ClearProperty(Search.ActiveType,home)</ontextchange>
			<onright condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsGreater(Container(16101).NumItems,0)">16201</onright>
			<onright condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsEqual(Container(16101).NumItems,0) + Integer.IsGreater(Container(16102).NumItems,0)">16202</onright>
			<onright>noop</onright>
			<onback condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive]">16101</onback>
			<onback condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchTVShowsActive]">16102</onback>
			<onback>9000</onback>
		</control>

		<!-- The edit above remains only as the receiver for Number* actions. Kodi's
		     edit control consumes Back as character deletion, so a transparent
		     button owns the visible input row's navigation instead. -->
		<control type="group">
			<left>30</left>
			<top>92</top>
			<width>280</width>
			<height>76</height>
			<control type="button" id="16998">
				<width>280</width>
				<height>76</height>
				<label></label>
				<texturefocus />
				<texturenofocus />
				<onfocus>ClearProperty(Search.KeyboardHidden,home)</onfocus>
				<onup>9000</onup>
				<ondown>16992</ondown>
				<onleft>noop</onleft>
				<onright condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsGreater(Container(16101).NumItems,0)">16201</onright>
				<onright condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsEqual(Container(16101).NumItems,0) + Integer.IsGreater(Container(16102).NumItems,0)">16202</onright>
				<onright>noop</onright>
				<onback condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive]">16101</onback>
				<onback condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchTVShowsActive]">16102</onback>
				<onback>9000</onback>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>280</width>
				<height>72</height>
				<font>font34_search</font>
				<label>$INFO[Control.GetLabel(16999).index(1)]</label>
				<textcolor>text_primary</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<scroll>true</scroll>
			</control>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>280</width>
				<height>1</height>
				<texture colordiffuse="text_secondary">colors/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>280</width>
				<height>3</height>
				<texture colordiffuse="focus_indicator">colors/white.png</texture>
				<visible>Control.HasFocus(16998)</visible>
			</control>
		</control>

		<!-- Exact Fuse 2 six-column A-Z / 0-9 toggle / backspace panel. -->
		<control type="panel" id="16992">
			<left>30</left>
			<top>214</top>
			<width>280</width>
			<height>420</height>
			<orientation>vertical</orientation>
			<onfocus>ClearProperty(Search.KeyboardHidden,home)</onfocus>
			<onup>16998</onup>
			<ondown condition="!String.IsEmpty(Window(home).Property(Search.NumbersVisible))">16994</ondown>
			<ondown>noop</ondown>
			<onleft>noop</onleft>
			<onright condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsGreater(Container(16101).NumItems,0)">16201</onright>
			<onright condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsEqual(Container(16101).NumItems,0) + Integer.IsGreater(Container(16102).NumItems,0)">16202</onright>
			<onright>noop</onright>
			<onback condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive]">16101</onback>
			<onback condition="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchTVShowsActive]">16102</onback>
			<onback>9000</onback>
			<itemlayout width="46" height="60">
				<include content="NaraSearchKeyboardItemLayout" />
			</itemlayout>
			<focusedlayout width="46" height="60">
				<include content="NaraSearchKeyboardItemLayout">
					<param name="focused" value="true" />
					<param name="textcolor" value="focus_foreground" />
				</include>
			</focusedlayout>
			<content>
				<item><label>A</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputA</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>B</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputB</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>C</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputC</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>D</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputD</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>E</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputE</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>F</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputF</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>G</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputG</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>H</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputH</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>I</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputI</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>J</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputJ</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>K</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputK</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>L</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputL</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>M</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputM</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>N</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputN</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>O</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputO</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>P</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputP</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>Q</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputQ</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>R</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputR</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>S</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputS</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>T</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputT</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>U</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputU</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>V</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputV</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>W</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputW</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>X</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputX</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>Y</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputY</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>Z</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputZ</include><onclick>SetFocus(16992)</onclick></item>
				<item>
					<label>$VAR[NaraSearchNumber0]</label>
					<onclick condition="!String.IsEmpty(Window(home).Property(Search.NumbersVisible))">ClearProperty(Search.NumbersVisible,home)</onclick>
					<onclick condition="String.IsEmpty(Window(home).Property(Search.NumbersVisible))">SetProperty(Search.NumbersVisible,True,home)</onclick>
					<onclick>SetFocus(16992)</onclick>
				</item>
				<item><label></label><icon>icons/keyboard/backspace.png</icon><onclick>SetFocus(16999)</onclick><include>NaraSearchInputBackspace</include><onclick>SetFocus(16992)</onclick></item>
			</content>
		</control>

