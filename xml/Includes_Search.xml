				<orientation>horizontal</orientation>
				<movement>6</movement>
				<scrolltime tween="quadratic">350</scrolltime>
				<selectionsettledelay>300</selectionsettledelay>
				<preloaditems>2</preloaditems>
				<onfocus>SetProperty(Search.KeyboardHidden,true,home)</onfocus>
				<onleft>16992</onleft>
				<onright>16101</onright>
				<onup>16201</onup>
				<ondown>16101</ondown>
				<onback>9000</onback>
