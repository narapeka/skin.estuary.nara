				<left>80</left>
				<top>605</top>
				<width>440</width>
				<height>52</height>
				<orientation>horizontal</orientation>
				<itemgap>5</itemgap>
				<control type="button" id="16201">
					<width max="220">auto</width><height>52</height>
					<font>font13</font><align>center</align><aligny>center</aligny><textoffsetx>0</textoffsetx>
					<label> $LOCALIZE[342] ($INFO[Container(16101).NumItems]) </label>
					<textcolor>00FFFFFF</textcolor><focusedcolor>00FFFFFF</focusedcolor>
					<texturefocus /><texturenofocus />
