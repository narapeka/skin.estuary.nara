	<include name="NaraSearchPosterLayout">
		<param name="focused">false</param>
		<param name="titlecolor">text_primary</param>
		<param name="show_year">false</param>
		<definition>
			<control type="group">
				<control type="image">
					<left>-4</left>
					<top>-3</top>
					<width>242</width>
					<height>349</height>
					<texture cornerradius="14" cornerborder="2" cornerglow="12" colordiffuse="focus_media">colors/white.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>11</top>
					<width>214</width>
					<height>321</height>
					<aspectratio>scale</aspectratio>
					<texture background="true" fallback="DefaultVideo.png" cornerradius="12">$VAR[PosterVar]</texture>
				</control>
				<control type="image">
					<right>17</right>
					<top>298</top>
					<width>24</width>
