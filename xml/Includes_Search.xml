			<animation effect="fade" time="400">VisibleChange</animation>
		</control>
		<control type="image">
			<width>1200</width>
			<height>1080</height>
			<aspectratio>stretch</aspectratio>
			<texture>overlays/detail-left-scrim.png</texture>
			<visible>[!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive] + !Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(16101).ListItemSettled.Art(fanart))] | [!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchTVShowsActive] + !Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(16102).ListItemSettled.Art(fanart))]</visible>
			<animation effect="fade" time="400">VisibleChange</animation>
		</control>
		<control type="image">
			<top>420</top>
			<width>1920</width>
			<height>660</height>
			<aspectratio>stretch</aspectratio>
			<texture colordiffuse="opacity_medium">overlays/overlayfade.png</texture>
			<visible>!String.IsEmpty(Control.GetLabel(16999).index(1))</visible>
		</control>

		<!-- Match the detail page's poster fallback when fanart is unavailable. -->
