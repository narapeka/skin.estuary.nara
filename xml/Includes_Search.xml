				<texturenofocus border="0,0,0,3" infill="false" colordiffuse="80FFFFFF">colors/white.png</texturenofocus>
				<hitrect x="0" y="0" w="0" h="0" />
				<visible>$PARAM[visible] + $PARAM[selected] + !$PARAM[focused]</visible>
