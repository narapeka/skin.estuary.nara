			<left>340</left>
			<width>1920</width>
			<height>1080</height>
			<animation effect="slide" start="0,0" end="-340,0" time="320" tween="cubic" easing="inout" reversible="true" condition="$EXP[NaraSearchKeyboardHidden]">Conditional</animation>

			<include content="NaraSearchHero">
				<param name="container_id" value="16101" />
				<param name="visible" value="!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive]" />
				<param name="metadata" value="$INFO[Container(16101).ListItemSettled.Year]$INFO[Container(16101).ListItemSettled.Mpaa,  &#183;  ]$INFO[Container(16101).ListItemSettled.Duration,  &#183;  ]$INFO[Container(16101).ListItemSettled.Genre,  &#183;  ]" />
			</include>
			<include content="NaraSearchHero">
				<param name="container_id" value="16102" />
