					<onfocus>SetProperty(Search.KeyboardHidden,true,home)</onfocus>
					<onleft>16992</onleft>
					<onright condition="Integer.IsGreater(Container(16102).NumItems,0)">16202</onright>
					<onright>noop</onright>
					<onup>9000</onup><ondown>16101</ondown><onback>9000</onback>
					<onclick>SetFocus(16101)</onclick>
					<visible>!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsGreater(Container(16101).NumItems,0)</visible>
				</control>
				<control type="button" id="16202">
					<width max="220">auto</width><height>52</height>
					<font>font13</font><align>center</align><aligny>center</aligny><textoffsetx>0</textoffsetx>
					<label> $LOCALIZE[20343] ($INFO[Container(16102).NumItems]) </label>
					<textcolor>00FFFFFF</textcolor><focusedcolor>00FFFFFF</focusedcolor>
					<texturefocus /><texturenofocus />
					<onfocus>SetProperty(Search.ActiveType,tvshows,home)</onfocus>
					<onfocus>SetProperty(Search.KeyboardHidden,true,home)</onfocus>
					<onleft condition="Integer.IsGreater(Container(16101).NumItems,0)">16201</onleft>
					<onleft>16992</onleft>
					<onright>noop</onright>
					<onup>9000</onup><ondown>16102</ondown><onback>9000</onback>
					<onclick>SetFocus(16102)</onclick>
					<visible>!String.IsEmpty(Control.GetLabel(16999).index(1)) + Integer.IsGreater(Container(16102).NumItems,0)</visible>
				</control>
				<visible>!String.IsEmpty(Control.GetLabel(16999).index(1)) + [Integer.IsGreater(Container(16101).NumItems,0) | Integer.IsGreater(Container(16102).NumItems,0)]</visible>
			</control>
			<control type="grouplist">
				<left>80</left>
				<top>605</top>
				<width>440</width>
				<height>52</height>
				<orientation>horizontal</orientation>
				<itemgap>5</itemgap>
				<hitrect x="0" y="0" w="0" h="0" />
