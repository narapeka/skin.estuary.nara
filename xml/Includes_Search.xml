		</control>

		<!-- Keep the off-screen rail focusable so Left from the results can restore it. -->
		<control type="group" id="16010">
			<top>140</top>
			<width>340</width>
			<height>940</height>
			<animation effect="slide" start="0,0" end="-340,0" time="320" tween="cubic" easing="inout" reversible="true" condition="$EXP[NaraSearchKeyboardHidden]">Conditional</animation>
			<animation effect="fade" start="100" end="0" time="220" reversible="true" condition="$EXP[NaraSearchKeyboardHidden]">Conditional</animation>
			<control type="image">
				<width>340</width><height>940</height>
				<texture colordiffuse="3318171E">colors/white.png</texture>
			</control>
			<control type="group">
				<top>-80</top>
				<include>NaraSearchKeyboard</include>
			</control>
		</control>

		<!-- Collapsing the rail moves the results onto the detail-page coordinates. -->
