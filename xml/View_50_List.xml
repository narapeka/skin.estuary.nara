			<!-- DefaultBackground supplies the selected fanart. These frameless scrims
			     preserve the image while giving the precision list a stable contrast field. -->
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="33000000">colors/black.png</texture>
			</control>
			<control type="image">
				<width>1320</width>
				<height>1080</height>
				<aspectratio>stretch</aspectratio>
				<texture colordiffuse="E6000000">overlays/detail-left-scrim.png</texture>
			</control>
			<control type="image">
				<top>400</top>
				<width>1920</width>
				<height>680</height>
				<aspectratio>stretch</aspectratio>
				<texture colordiffuse="66FFFFFF">overlays/overlayfade.png</texture>
			</control>

