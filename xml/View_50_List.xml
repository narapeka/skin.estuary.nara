				<animation effect="zoom" end="55,100" time="250" tween="sine" center="942,0" easing="inout" condition="!Control.HasFocus(50600)">Conditional</animation>
			</control>

			<!-- The right half is deliberately passive: fanart, copy and position only. -->
			<control type="group">
				<left>1018</left>
				<centertop>50%</centertop>
				<width>802</width>
				<height>570</height>
				<!-- Reuse the exact movie/TV detail Hero composition and MediaFlag
				     controls; this view only adapts the settled container data source. -->
				<include content="VideoInfoHeroContent">
					<param name="synopsis_height" value="134" />
					<param name="tv_synopsis_height" value="134" />
					<param name="clearlogo_width" value="700" />
					<param name="clearlogo_height" value="140" />
					<param name="item_dbtype" value="Container(50).ListItemSettled.DBType" />
					<param name="clearlogo_texture" value="$VAR[NaraList50ClearLogoVar]" />
					<param name="clearlogo_visible" value="!String.IsEmpty(Container(50).ListItemSettled.Art(clearlogo)) | !String.IsEmpty(Container(50).ListItemSettled.Art(tvshow.clearlogo))" />
					<param name="clearlogo_missing" value="String.IsEmpty(Container(50).ListItemSettled.Art(clearlogo)) + String.IsEmpty(Container(50).ListItemSettled.Art(tvshow.clearlogo))" />
					<param name="hero_title" value="$VAR[NaraList50TitleVar]" />
					<param name="episode_label" value="$VAR[NaraList50EpisodeLabelVar]" />
					<param name="episode_visible" value="String.IsEqual(Container(50).ListItemSettled.DBType,episode) | String.IsEqual(Container(50).ListItemSettled.DBType,season)" />
					<param name="metadata_label" value="$VAR[NaraList50MetadataVar]" />
					<param name="rating_item_prefix" value="Container(50).ListItemSettled" />
					<param name="technical_visible" value="true" />
					<param name="technical_item_prefix" value="Container(50).ListItemSettled" />
					<param name="tagline_visible" value="!String.IsEqual(Container(50).ListItemSettled.DBType,tvshow) + !String.IsEmpty(Container(50).ListItemSettled.Tagline)" />
					<param name="tagline_missing" value="String.IsEqual(Container(50).ListItemSettled.DBType,tvshow) | String.IsEmpty(Container(50).ListItemSettled.Tagline)" />
					<param name="tagline_label" value="[I]$INFO[Container(50).ListItemSettled.Tagline][/I]" />
					<param name="synopsis_label" value="$VAR[NaraList50SynopsisVar]" />
				</include>
				<control type="label">
					<top>526</top>
					<width>780</width>
					<height>34</height>
					<font>font12</font>
					<textcolor>text_muted</textcolor>
					<label>$INFO[Container(50).CurrentItem]  /  $INFO[Container(50).NumItems]</label>
				</control>
			</control>
		</control>
	</include>
