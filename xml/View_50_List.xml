				<onleft condition="!$EXP[nara_tv_hierarchy_sidebar_locked]">9000</onleft>
				<onright>50600</onright>
				<onup>50</onup>
				<ondown>50</ondown>
				<viewtype label="$LOCALIZE[535]">list</viewtype>
				<visible>!Container.Content(seasons)</visible>
				<focusedlayout height="84">
					<control type="image">
						<left>0</left>
						<right>0</right>
						<top>4</top>
						<bottom>4</bottom>
						<texture cornerradius="12" colordiffuse="focus_surface">colors/white.png</texture>
