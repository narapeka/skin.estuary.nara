					</control>
					<control type="image">
						<left>0</left>
						<right>0</right>
						<top>4</top>
						<bottom>4</bottom>
						<texture cornerradius="12" colordiffuse="selection_surface">colors/white.png</texture>
						<visible>!Control.HasFocus(50)</visible>
					</control>
					<control type="image">
						<left>22</left>
						<top>17</top>
						<width>50</width>
						<height>50</height>
						<texture cornerradius="25" colordiffuse="focus_foreground_muted">colors/white.png</texture>
					</control>
					<control type="image">
						<left>22</left>
						<top>17</top>
						<width>50</width>
						<height>50</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" cornerradius="25">$VAR[IconWallThumbVar]</texture>
					</control>
					<control type="label">
						<left>96</left>
						<right>228</right>
						<top>0</top>
						<bottom>0</bottom>
						<aligny>center</aligny>
						<scroll>true</scroll>
						<font>font25</font>
						<label>$VAR[ListLabelVar]</label>
						<textcolor>$VAR[NaraList50FocusedTextColorVar]</textcolor>
						<selectedcolor>$VAR[NaraList50FocusedTextColorVar]</selectedcolor>
					</control>
					<control type="label">
						<left>642</left>
						<width>132</width>
						<top>0</top>
						<bottom>0</bottom>
						<align>right</align>
						<aligny>center</aligny>
						<font>font12</font>
						<label>$VAR[NaraList50PrimaryMetaVar]</label>
						<textcolor>$VAR[NaraList50FocusedMetaColorVar]</textcolor>
						<selectedcolor>$VAR[NaraList50FocusedMetaColorVar]</selectedcolor>
					</control>
					<control type="label">
						<left>790</left>
						<right>22</right>
						<top>0</top>
						<bottom>0</bottom>
						<align>right</align>
						<aligny>center</aligny>
						<font>font12</font>
