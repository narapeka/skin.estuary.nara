						<left>790</left>
						<right>22</right>
						<top>0</top>
						<bottom>0</bottom>
						<align>right</align>
						<aligny>center</aligny>
						<font>font12</font>
						<label>$VAR[NaraList50SecondaryMetaVar]</label>
